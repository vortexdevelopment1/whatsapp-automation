# Application
PROJECT_NAME="Rental Operations - Module 1"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api"
SECRET_KEY="replace-with-a-strong-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rental_ops_dev"

# Storage
STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="./uploads"

# Meta WhatsApp Cloud API (Keep in backend only - NEVER EXPOSE TO FRONTEND)
META_ACCESS_TOKEN=""
META_VERIFY_TOKEN="your_meta_webhook_verify_token"
META_APP_SECRET=""
META_API_VERSION="v20.0"
META_PHONE_NUMBER_ID=""
META_BUSINESS_ACCOUNT_ID=""

# AI Orchestration (Module 3)
AI_PROVIDER="mock"
AI_MODEL="gpt-4o-mini"
AI_API_KEY=""
AI_API_BASE="https://api.openai.com/v1"
AI_TIMEOUT_SECONDS=15.0
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.0
AI_MAX_OUTPUT_TOKENS=1000
AI_FALLBACK_PROVIDER=""
AI_FALLBACK_MODEL=""


    